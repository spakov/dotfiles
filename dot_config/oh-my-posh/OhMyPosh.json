{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "console_title_template": "{{ .Folder }}",
  "final_space": true,
  "palette": {
    "iconBg": "blue",
    "iconFg": "black",
    "hostnameBg": "blue",
    "hostnameFg": "darkGray",
    "pathBg": "magenta",
    "pathFg": "darkGray",
    "gitBg": "cyan",
    "gitFg": "darkGray",
    "nbgvBg": "yellow",
    "nbgvFg": "darkGray",
    "pythonBg": "green",
    "pythonFg": "darkGray"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "background": "p:iconBg",
          "foreground": "p:iconFg",
          "style": "plain",
          "template": "󰏩 "
        },
        {
          "type": "session",
          "background": "p:hostnameBg",
          "foreground": "p:hostnameFg",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "<p:hostnameBg,p:pathBg></>",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "background": "p:pathBg",
          "foreground": "p:pathFg",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "folder_icon": "󰉋 ",
            "home_icon": "󰋜 ",
            "style": "full",
            "mapped_locations": {
              "~/Projects": " "
            }
          }
        },
        {
          "type": "git",
          "background": "p:gitBg",
          "foreground": "p:gitFg",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "cherry_pick_icon": " ",
            "commit_icon": " ",
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          }
        },
        {
          "type": "nbgv",
          "background": "p:nbgvBg",
          "foreground": "p:nbgvFg",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ .SimpleVersion }} "
        },
        {
          "type": "python",
          "background": "p:pythonBg",
          "foreground": "p:pythonFg",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "  {{ .Venv }} "
        }
      ]
    }
  ]
}
