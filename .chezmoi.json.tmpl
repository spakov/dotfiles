{{- $email := promptStringOnce . "email" "GitHub email address" -}}

{
  "cd": {
    {{- if eq .chezmoi.os "windows" }}
    "command": "pwsh"
    {{- end }}
  },
  "data": {
    "email": {{ $email | quote }}
  },
  "diff": {
    "command": "nvim",
    "args": [
      "-d",
      "-R"
    ]
  },
  "merge": {
    "command": "nvim",
    "args": [
      "-d",
      {{ printf "%q" "{{ .Destination }}" }},
      {{ printf "%q" "{{ .Source }}" }},
      {{ printf "%q" "{{ .Target }}" }}
    ]
  },
  "shell": {
    {{- if eq .chezmoi.os "windows" }}
    "command": "pwsh"
    {{- end }}
  }
}

